{
  "name": "clarion-backend-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "lab": "node scripts/lab.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build:test": "esbuild src/index.ts --bundle --format=esm --platform=browser --external:cloudflare:workers --outfile=dist/index.js",
    "test": "npm run build:test && vitest run",
    "demo:reset": "node scripts/demo-reset.mjs",
    "e2e:live": "node scripts/e2e-live.mjs",
    "e2e:wa": "node scripts/e2e-wa.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.3-beta",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
